"""Independent live capture pool, durable configuration and segmented replays."""
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
import json
import re
from pathlib import Path
import shutil
import subprocess
import threading
import time
import uuid

from fastapi import HTTPException
from pydantic import BaseModel, Field, model_validator
from . import hardware, live_browser
from .storage import atomic_json, defer_text, flush_deferred

ZONE = timezone(timedelta(hours=8))


class Window(BaseModel):
    days: list[int] = Field(default_factory=lambda: list(range(7)), min_length=1, max_length=7)
    start: str = '00:00'
    end: str = '00:00'

    @model_validator(mode='after')
    def validate_window(self):
        import re
        if any(d < 0 or d > 6 for d in self.days) or any(not re.fullmatch(r'(?:[01]\d|2[0-3]):[0-5]\d', t) for t in (self.start, self.end)):
            raise ValueError('请选择周一至周日和有效的开始、结束时间')
        return self


class Anchor(BaseModel):
    id: str = ''
    name: str = Field(default='', max_length=100)
    url: str = Field(max_length=2000)
    enabled: bool = False
    quality: str = 'origin'
    windows: list[Window] = Field(default_factory=list, max_length=30)
    monitor_device:str='pc'
    record_target:str='ask'

    @model_validator(mode='after')
    def validate_anchor(self):
        self.url = live_browser.normalize(self.url)
        if self.quality not in ('origin', 'high', 'standard'): raise ValueError('未知直播画质')
        if self.monitor_device not in ('pc','phone') or self.record_target not in ('pc','phone','ask'):raise ValueError('请选择检测设备与录制设备')
        return self


class LiveSettings(BaseModel):
    concurrency: int = Field(default=4, ge=1, le=8)
    output: str = ''
    segment_minutes: int = Field(default=30, ge=1, le=120)
    follow_global: bool | None = None

    @model_validator(mode='after')
    def validate_output(self):
        if self.follow_global is True:self.output=''
        self.follow_global=not bool(self.output)
        return self


def in_window(windows, now=None):
    if not windows: return True
    now = now or datetime.now(ZONE)
    minute = now.strftime('%H:%M')
    for window in windows:
        start, end, days = window['start'], window['end'], window['days']
        if start == end and now.weekday() in days: return True
        if start < end and now.weekday() in days and start <= minute < end: return True
        if start > end and ((now.weekday() in days and minute >= start) or ((now.weekday()-1) % 7 in days and minute < end)): return True
    return False


class Manager:
    def __init__(self, a):
        self.a = a
        self.path = a.DATA/'live-settings.json'
        self.lock = threading.RLock()
        self.stopping = threading.Event()
        self.pool = ThreadPoolExecutor(max_workers=8, thread_name_prefix='live')
        raw = a.load_json(self.path, {})
        if not isinstance(raw, dict): raw = {}
        raw_settings=raw.get('settings',{})
        if not isinstance(raw_settings,dict):raw_settings={}
        try: self.settings = LiveSettings(**raw_settings).model_dump()
        except (ValueError, TypeError): self.settings = LiveSettings().model_dump()
        # Older UI materialized the global path. Restore inheritance when it
        # still matches; preserve distinct explicit directories conservatively.
        if ('follow_global' not in raw_settings and self.settings['output']
                and self.settings['output']==getattr(a,'SETTINGS',{}).get('output')):
            self.settings['output']=''
            self.settings['follow_global']=True
        self.anchors = {}
        for value in raw.get('anchors', []) if isinstance(raw.get('anchors', []), list) else []:
            try:
                item = Anchor(**value).model_dump()
                if item['id']: self.anchors[item['id']] = item
            except (ValueError, TypeError): pass
        identities=raw.get('identities',{})
        self.identities={k:v for k,v in identities.items() if k in self.anchors and isinstance(v,dict)
                         and v.get('source_url')==self.anchors[k]['url'] and re.fullmatch(r'\d{4,30}',str(v.get('room_id','')))} if isinstance(identities,dict) else {}
        self.active = {}
        self.pending = {}
        self.runtime = {}
        self.next_check = {}
        self.last_check_job = {}
        # Rooms the user explicitly stopped: keep auto monitoring alive, but do
        # not immediately re-record the very same live room.
        self.suppressed = {}
        # Last resolved stream per anchor, memory only: lets a manual phone
        # recording reuse a fresh address instead of resolving again on mobile.
        self.last_info = {}
        self.thread = None
        # Recover only the exact in-progress file persisted before capture.
        for job in list(a.JOBS.values()):
            pending = job.get('live_pending')
            if job['kind'] != 'live-recording' or not pending or job['status'] != 'interrupted': continue
            try:
                path = a.safe_file(job, pending['name'])
                if path.stat().st_size > 1024:
                    segments = [*job.get('replay', []), {**pending, 'preview': pending['name'], 'complete': False,
                                'gap_before': True, 'ended': job.get('updated', time.time())}]
                    a.change(job['id'], replay=segments, live_pending=None)
                    a.refresh_partial_files(job['id'])
            except Exception: pass
        self.prune_empty_checks()

    def prune_empty_checks(self):
        """Drop old monitoring checks that never captured anything.

        Earlier versions created a job and a folder for every failed check, so a
        single night left hundreds of empty cards in the user's list. Only jobs
        that are automatic, have no segment and no file on disk are touched.
        """
        removed = 0
        lock = getattr(self.a, 'LOCK', None)
        if lock is None or not getattr(self.a, 'JOBS', None):
            return 0
        with lock:
            for jid, job in list(self.a.JOBS.items()):
                if job.get('kind') != 'live-recording' or job.get('replay'): continue
                if not (job.get('options') or {}).get('automatic'): continue
                if job.get('status') not in ('done', 'error', 'cancelled', 'interrupted'): continue
                base = Path(job.get('directory') or '')
                try:
                    if base.is_dir() and any(base.iterdir()): continue
                except OSError: continue
                self.a.JOBS.pop(jid, None)
                self.a.EVENTS.pop(jid, None)
                self.a.SESSION_LOCKS.pop(jid, None)
                try: base.rmdir()
                except OSError: pass
                removed += 1
            if removed:
                try: self.a.persist()
                except Exception: pass
        return removed

    def save(self):
        # Serialize now, write later: callers hold the manager lock, and a slow
        # disk must not freeze every API request behind one fsync.
        defer_text(self.path, json.dumps(
            {'settings': self.settings, 'anchors': list(self.anchors.values()), 'identities': self.identities},
            ensure_ascii=False, indent=2))

    def known_room(self,url):
        match=re.fullmatch(r'https://webcast\.amemv\.com/douyin/webcast/reflow/(\d{4,30})/',url)
        if match:return match[1]
        return next((v['room_id'] for k,v in self.identities.items() if k in self.anchors
                     and url in (v.get('source_url'),v.get('resolved_url'))),None)

    def remember_room(self,key,anchor,info):
        room_id=str(info.get('room_id') or '')
        if not re.fullmatch(r'\d{4,30}',room_id):return
        with self.lock:
            if key not in self.anchors or self.anchors[key]['url']!=anchor['url']:return
            identity={'source_url':anchor['url'],'room_id':room_id}
            try:identity['resolved_url']=live_browser.normalize(info.get('referer',''))
            except ValueError:pass
            if self.identities.get(key)!=identity:self.identities[key]=identity;self.save()

    def state(self):
        with self.lock:
            settings=dict(self.settings,follow_global=not self.settings['output'])
            settings['output']=self.settings['output'] or str(self.a.SETTINGS['output'])
            return {'settings': settings, 'anchors': [dict(v, runtime=dict(self.runtime.get(k, {})),
                    active_job=self.active.get(k) or self.pending.get(k)) for k, v in self.anchors.items()]}

    def put(self, req):
        item = req.model_dump()
        with self.lock:
            room_id=self.known_room(item['url'])
            existing = next((v for v in self.anchors.values() if v['id']!=item['id'] and
                             (v['url'].rstrip('/') == item['url'].rstrip('/') or
                              (room_id and self.known_room(v['url'])==room_id))), None)
            if item['id'] and item['id'] not in self.anchors: raise HTTPException(404, '主播不存在')
            if existing and existing['id'] != item['id']:
                raise HTTPException(409, '此主播已在列表中，请修改已有设置')
            if not item['id']: item['id'] = uuid.uuid4().hex[:12]
            if item['id'] in self.anchors and self.anchors[item['id']]['url']!=item['url']:
                self.identities.pop(item['id'],None)
            item['name'] = item['name'].strip()
            self.anchors[item['id']] = item
            self.save()
            self.next_check[item['id']] = 0
            return item

    def start_service(self):
        if self.thread and self.thread.is_alive(): return
        self.thread = threading.Thread(target=self.loop, name='live-monitor', daemon=True)
        self.thread.start()

    def loop(self):
        while not self.stopping.is_set():
            try: self.tick()
            except Exception: pass
            self.stopping.wait(2)

    def tick(self):
        """One scheduling pass; separated so the policy can be tested."""
        with self.lock:
            for key, jid in list(self.pending.items()):
                if len(self.active) >= self.settings['concurrency']: break
                self.start(key, queued_jid=jid)
            for key, item in list(self.anchors.items()):
                # The desktop is the always-on monitor. A phone-only monitor
                # stops the moment the companion leaves the foreground, which
                # is exactly how live starts were missed, so monitoring never
                # depends on where recording happens.
                allowed = item['enabled'] and in_window(item['windows'])
                if key in self.active:
                    if self.runtime.get(key, {}).get('automatic') and not allowed:
                        self.a.EVENTS[self.active[key]].set()
                    continue
                if allowed and time.monotonic() >= self.next_check.get(key, 0):
                    try: self.start(key, automatic=True)
                    except HTTPException: pass

    def start(self, key, automatic=False, queued_jid=None):
        with self.lock:
            if key not in self.anchors: raise HTTPException(404, '主播不存在')
            if key in self.active: return {'id': self.active[key]}
            if key in self.pending and not queued_jid: return {'id': self.pending[key], 'queued': True}
            # A manual start is an explicit "record this live now", so it must
            # clear the stop guard instead of silently ending on the same room.
            if not automatic: self.suppressed.pop(key, None)
            if len(self.active) >= self.settings['concurrency']:
                self.runtime[key] = {'message': '等待录播名额', 'state': 'queued'}
                if not automatic:
                    anchor = self.anchors[key]
                    job = self.a.new_job('live-recording', (anchor['name'] or '待读取昵称')+' · 等待录播', self.settings['output'], anchor['url'],
                        {'anchor_id': key, 'automatic': False, 'quality': anchor['quality']})
                    self.pending[key] = job['id']
                    return {'id': job['id'], 'queued': True}
                self.next_check[key] = time.monotonic()+10
                return {}
            anchor = dict(self.anchors[key])
            previous = self.a.JOBS.get(self.last_check_job.get(key))
            if queued_jid:
                job = self.a.job_by_id(queued_jid); self.pending.pop(key, None)
            elif previous and not previous.get('replay') and previous['status'] == 'done':
                job = previous; self.a.EVENTS[job['id']].clear()
                self.a.change(job['id'], status='queued', message='再次检查开播状态')
            else:
                job = self.a.new_job('live-recording', (anchor['name'] or '待读取昵称')+' · 直播录播', self.settings['output'], anchor['url'],
                                     {'anchor_id': key, 'automatic': automatic, 'quality': anchor['quality']})
            self.last_check_job[key] = job['id']
            self.active[key] = job['id']
            self.runtime[key] = {'message': '检查开播状态', 'state': 'checking', 'automatic': automatic}
            self.pool.submit(self.record, key, anchor, job['id'], automatic)
            return {'id': job['id']}

    def recent_info(self, key):
        item = self.last_info.get(key)
        if not item or time.time()-item[0] > 600: return None
        return item[1]

    def stop(self, key, disable=False):
        with self.lock:
            if key not in self.anchors: raise HTTPException(404, '主播不存在')
            if disable: self.anchors[key]['enabled'] = False; self.save()
            room = self.runtime.get(key, {}).get('room_id')
            if room: self.suppressed[key] = room
            jid = self.active.get(key)
            if jid: self.a.EVENTS[jid].set()
            pending = self.pending.pop(key, None)
            if pending:
                self.a.EVENTS[pending].set()
                self.a.change(pending, status='cancelled', message='已取消等待录播')
            self.notify_phone(key, 'stop')
            return {'message': '正在停止并保存；该主播再次开播仍会自动录制'}

    def phone(self):
        """Return the companion when the phone itself is still attached.

        A quiet companion is not necessarily gone: it is usually just sitting
        in the background, and ``request_record`` wakes it. Only a phone with no
        live ADB transport is treated as absent, so a real live start still
        falls back to desktop recording immediately.
        """
        phone = getattr(self.a, 'MOBILE', None)
        if phone is None: return None
        try:
            if time.time() - float(phone.last_seen or 0) < 25: return phone
            return phone if phone.reachable(phone.preferred()) else None
        except Exception: return None

    def phone_capture(self, key):
        phone = getattr(self.a, 'MOBILE', None)
        if phone is None: return None
        try:
            with phone.lock: state = dict(getattr(phone, 'phone_status', {}) or {})
        except Exception: return None
        for item in state.get('active') or []:
            if isinstance(item, dict) and item.get('anchor_id') == key: return item
        return None

    def notify_phone(self, key, action='record', info=None):
        phone = self.phone()
        if phone is None: return False
        try:
            phone.request_record(key, action, info)
            return True
        except Exception: return False

    def capture_segment(self, jid, info, target, duration, on_first_bytes=None):
        a = self.a
        # Headers remain private, never enter persisted jobs, evidence or command logs.
        header = 'Referer: '+info.get('referer', 'https://live.douyin.com/')+'\r\n'
        cookies = info.get('cookies', [])
        if cookies: header += 'Cookie: '+'; '.join(c['name']+'='+c['value'] for c in cookies)+'\r\n'
        args = [a.FFMPEG, '-hide_banner', '-loglevel', 'error', '-y', '-rw_timeout', '20000000',
                '-user_agent', info.get('user_agent', 'VideoDesk'), '-headers', header, '-i', info['url'],
                '-t', str(duration), '-map', '0:v:0', '-map', '0:a:0?', '-c', 'copy', '-f', 'matroska', str(target)]
        proc = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
        started_at = time.time()
        with a.LOCK: a.PROCESSES[jid] = proc
        interrupted = False
        confirmed = False
        try:
            while proc.poll() is None:
                # "recording" only after real media bytes landed on disk, so a
                # refused stream can never look like a successful recording.
                if not confirmed and time.time() > started_at + 0.3:
                    try: confirmed = target.stat().st_size > 2048
                    except OSError: confirmed = False
                    if confirmed and on_first_bytes: on_first_bytes()
                if a.EVENTS[jid].wait(.5) or self.stopping.is_set() or shutil.disk_usage(target.parent).free < 2*1024**3:
                    interrupted = True
                    try: proc.stdin.write(b'q\n'); proc.stdin.flush(); proc.wait(timeout=12)
                    except (OSError, subprocess.TimeoutExpired):
                        proc.terminate()
                        try: proc.wait(timeout=5)
                        except subprocess.TimeoutExpired: proc.kill(); proc.wait()
                    break
            return proc.returncode, interrupted, confirmed
        finally:
            if proc.poll() is None: proc.kill(); proc.wait()
            if proc.stdin: proc.stdin.close()
            with a.LOCK: a.PROCESSES.pop(jid, None)

    def record(self, key, anchor, jid, automatic):
        a = self.a; base = Path(a.job_by_id(jid)['directory']); segments = []; failures = 0
        phone_tries = 0
        note = None
        event = a.EVENTS[jid]
        try:
            base.mkdir(parents=True, exist_ok=True)
            a.change(jid, status='running', message='正在读取直播间')
            while not event.is_set() and not self.stopping.is_set():
                if shutil.disk_usage(base).free < 2*1024**3: raise ValueError('磁盘剩余不足 2 GB，录播已安全停止')
                try:
                    info = live_browser.resolve(a.BROWSER, anchor['url'], anchor['quality'], lambda:event.is_set() or self.stopping.is_set())
                    if not anchor['name'] and info.get('name'):
                        with self.lock:
                            anchor['name']=info['name'][:100]
                            if key in self.anchors:self.anchors[key]['name']=anchor['name'];self.save()
                        a.change(jid,title=anchor['name']+' · 直播录播')
                except Exception as exc:
                    failures += 1
                    reason=str(exc)[:250] or '直播页面读取失败'
                    self.runtime[key]={'state':'error','message':reason,'automatic':automatic}
                    if not automatic or failures >= 5: raise ValueError(reason+'；可改用手机检测／录制，或打开专用浏览器确认直播能正常播放') from exc
                    a.change(jid, status='waiting', message=reason+'；稍后重试')
                    event.wait(min(60, 5*2**failures)); continue
                if info.get('online') is not True and info.get('online') is not False:
                    raise ValueError('无法确认开播状态，请在专用浏览器确认直播能播放后重试；已有片段保留')
                if info['online'] is False:
                    self.suppressed.pop(key, None)
                    note = '未开播 · 检查于 '+time.strftime('%H:%M:%S')+' · 开播后自动录制'
                    if not segments:
                        a.change(jid, status='done', progress=100, phone_recording=False,
                                 message='当前未开播，自动监控会继续检查' if automatic else '当前未开播，可开启自动监控')
                        return
                    break
                self.remember_room(key,anchor,info)
                if info.get('url'): self.last_info[key] = (time.time(), info)
                canonical = info.get('room_id')
                with self.lock:
                    duplicate = any(k != key and v.get('room_id') == canonical for k, v in self.runtime.items()
                                    if canonical and k in self.active)
                    if not duplicate: self.runtime[key] = {'state': 'connecting', 'room_id': canonical, 'automatic': automatic, 'message': '正在连接直播流'}
                if duplicate: raise ValueError('这个直播间已由另一条主播记录录制，已避免重复录制')
                if canonical and self.suppressed.get(key) == canonical:
                    a.change(jid, status='done', progress=100, phone_recording=False,
                             message='已按你的操作停止本次录制；该主播再次开播会自动录制')
                    self.runtime[key] = {'state': 'idle', 'message': '已停止本次录制'}
                    self.next_check[key] = time.monotonic()+90
                    return
                # Phone first only when the user chose phone recording and the
                # companion is actually answering; otherwise the desktop records
                # immediately so a live start is never lost to a dead phone.
                if anchor.get('record_target') == 'phone' and phone_tries < 2 and self.notify_phone(key, 'record', info):
                    self.runtime[key] = {'state': 'phone-wait', 'room_id': canonical, 'automatic': automatic, 'message': '已通知手机录制，等待手机确认'}
                    a.change(jid, message='已通知手机录制，等待手机确认')
                    confirmed_phone = False
                    # A backgrounded phone needs a few seconds to come back and
                    # poll; 25s used to time out just before it answered.
                    deadline = time.time()+40
                    while time.time() < deadline and not event.is_set() and not self.stopping.is_set():
                        item = self.phone_capture(key)
                        if item and (item.get('bytes') or 0) > 65536: confirmed_phone = True; break
                        event.wait(1)
                    if confirmed_phone:
                        self.runtime[key] = {'state': 'recording', 'device': 'phone', 'room_id': canonical,
                                             'automatic': automatic, 'message': '手机正在录制'}
                        # No local segment will appear, so this flag is what keeps
                        # the recording visible in the workbench.
                        a.change(jid, status='running', message='手机正在录制', progress_indeterminate=True,
                                 phone_recording=True)
                        while not event.is_set() and not self.stopping.is_set():
                            if not self.phone_capture(key):
                                phone_tries += 1
                                a.change(jid, message='手机录制已停止，电脑接着录', phone_recording=False)
                                break
                            event.wait(10)
                        continue
                    phone_tries += 1
                    a.change(jid, message='手机未确认录制，改由电脑录制')
                number = len(segments)+1
                target = base/f'part-{number:04d}-{uuid.uuid4().hex[:8]}.mkv'
                started = time.time()
                a.change(jid, status='recording', message=f'正在录制第 {number} 段', progress_indeterminate=True,
                         live_pending={'name': target.name, 'started': started})
                def first_bytes():
                    with self.lock:
                        self.runtime[key] = {'state': 'recording', 'device': 'pc', 'room_id': canonical,
                                             'automatic': automatic, 'message': '录制中'}
                code, stopped, landed = self.capture_segment(jid, info, target, self.settings['segment_minutes']*60,
                                                             on_first_bytes=first_bytes)
                captured = target.is_file() and target.stat().st_size > 1024 and landed
                if target.is_file() and not landed:
                    # An empty or refused connection must not be reported as media.
                    try: target.unlink()
                    except OSError: pass
                if captured:
                    entry = {'name': target.name, 'started': started, 'ended': time.time(), 'gap_before': failures > 0,
                             'complete': code == 0, 'preview': target.name}
                    # The MKV already holds the live stream, so it is registered
                    # before the optional remux: a failed remux must never cost
                    # the user the recording that did land on disk.
                    segments.append(entry)
                    atomic_json(base/'replay.json', {'anchor': anchor['name'], 'segments': segments})
                    a.change(jid, replay=segments, live_pending=None)
                    out = target.with_suffix('.mp4')
                    try:
                        p = subprocess.run([a.FFMPEG, '-hide_banner', '-loglevel', 'error', '-nostdin', '-y', '-i', str(target),
                                            '-map', '0:v:0', '-map', '0:a:0?', '-c', 'copy', '-movflags', '+faststart', str(out)],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=90,
                                           creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
                        if p.returncode == 0 and out.stat().st_size > 1024:
                            entry['preview'] = out.name
                        else: out.unlink(missing_ok=True)
                    except Exception: out.unlink(missing_ok=True)
                    atomic_json(base/'replay.json', {'anchor': anchor['name'], 'segments': segments})
                    try: a.material_history.register_created(a, jid, [target, *([out] if entry['preview'] == out.name else []), base/'replay.json'])
                    except Exception: pass
                    a.change(jid, replay=segments)
                    a.refresh_files(jid)
                if stopped:
                    if not event.is_set() and not self.stopping.is_set(): raise ValueError('磁盘剩余不足 2 GB，录播已安全停止')
                    break
                if code != 0 or not captured:
                    failures += 1
                    a.change(jid, message='直播连接中断，重新获取地址后续录，已有片段保留')
                    if failures >= 5: raise ValueError('直播连续断开，已有片段保留，请检查网络或重新登录')
                    event.wait((5, 10, 20, 30)[min(failures-1, 3)])
                else: failures = 0
            a.change(jid, status='done', progress=100, message=f'已保存 {len(segments)} 段回放', progress_indeterminate=False,
                     phone_recording=False)
        except Exception as exc:
            # Deliberately no third-party exception details or signed URLs.
            message = str(exc) if isinstance(exc, ValueError) else '录播未完成，请检查登录、网络和保存目录；已有片段保留'
            a.change(jid, status='error', message=message[:500], phone_recording=False)
        finally:
            a.refresh_partial_files(jid)
            message = ''
            try: message = a.job_by_id(jid)['message']
            except Exception: pass
            captured = bool(segments)
            with self.lock:
                self.active.pop(key, None)
                # Auto monitoring keeps checking quickly; a live start must not
                # wait five minutes just because the previous check failed.
                self.next_check[key] = time.monotonic()+(120 if failures >= 5 else 45)
                self.runtime[key] = {'state': 'idle', 'automatic': automatic,
                                     'message': note or message or '未开播，继续自动检查'}
            if not captured:
                # An automatic check that captured nothing must not leave an
                # empty folder or a failed card behind: a wall of "没录到"
                # entries makes the recordings that did work impossible to find.
                if automatic:
                    try: a.drop_job(jid, remove_directory=True)
                    except Exception: pass
                else:
                    try: base.rmdir()
                    except OSError: pass

    def close(self):
        self.stopping.set()
        with self.lock:
            for jid in list(self.active.values()):
                event = self.a.EVENTS.get(jid)
                if event: event.set()
            for jid in list(self.pending.values()):
                event = self.a.EVENTS.get(jid)
                if not event: continue
                event.set(); self.a.change(jid, status='cancelled', message='服务退出，已取消等待录播')
            self.pending.clear()
        if self.thread: self.thread.join(timeout=4)
        self.pool.shutdown(wait=True, cancel_futures=True)
        # Settings are written in the background while running; make sure the
        # last edit reaches disk before this manager goes away.
        flush_deferred()


def install(app, a):
    manager = Manager(a)

    @app.on_event('startup')
    def startup(): manager.start_service()

    @app.get('/api/live')
    def state(): return manager.state()

    @app.post('/api/live/settings')
    def settings(req: LiveSettings):
        value = req.model_dump()
        # Empty means follow the global directory at task creation, not at save time.
        if value['output']:value['output'] = str(a.output_dir(value['output']))
        with manager.lock: manager.settings = value; manager.save()
        return manager.state()

    @app.post('/api/live/anchors')
    def put(req: Anchor): return manager.put(req)

    @app.delete('/api/live/anchors/{key}')
    def delete(key: str):
        with manager.lock:
            if key in manager.active or key in manager.pending: raise HTTPException(409, '请先停止并保存此主播的录播')
            manager.anchors.pop(key, None); manager.identities.pop(key,None); manager.save()
        return {'ok': True}

    @app.post('/api/live/anchors/{key}/start')
    def start(key: str): return manager.start(key)

    @app.post('/api/live/anchors/{key}/stop')
    def stop(key: str): return manager.stop(key)

    @app.post('/api/live/following')
    def following():
        try: return live_browser.import_following(a.BROWSER)
        except Exception: raise HTTPException(400, '关注列表未读取成功，请在登录浏览器打开关注列表，完成登录后重试')

    @app.get('/api/live/replays')
    def replays():
        with a.LOCK:
            return {'jobs': [dict(j) for j in reversed(list(a.JOBS.values())) if j['kind'] == 'live-recording' and j.get('replay')]}

    @app.post('/api/live/replays/{jid}/preview/{number}')
    def preview(jid: str, number: int):
        job = a.job_by_id(jid)
        if job['kind'] != 'live-recording' or number < 0 or number >= len(job.get('replay', [])): raise HTTPException(404)
        segment = job['replay'][number]
        source = a.safe_file(job, segment['name'])
        target = source.with_name(source.stem+'-preview-'+uuid.uuid4().hex[:8]+'.mp4')
        def work():
            hardware.encode(a, jid, ['-i', str(source), '-vf', 'pad=ceil(iw/2)*2:ceil(ih/2)*2', '-pix_fmt', 'yuv420p'], ['-c:a', 'aac', '-movflags', '+faststart', str(target)])
            segment['preview'] = target.name
            a.change(jid, replay=job['replay'])
            atomic_json(Path(job['directory'])/'replay.json', {'anchor': job['title'], 'segments': job['replay']})
            a.material_history.register_created(a, jid, [Path(job['directory'])/'replay.json'])
            return '兼容回放已生成'
        if job['status'] not in ('done', 'error', 'interrupted', 'cancelled'): raise HTTPException(409, '请先停止录播，再生成兼容回放')
        a.EVENTS[jid].clear()
        a.change(jid, status='queued', message='排队生成兼容回放')
        a.WORKERS.submit(a.guarded, jid, work)
        return {'id': jid}

    return manager
